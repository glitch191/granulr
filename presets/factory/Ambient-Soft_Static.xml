    <PARAM id="mix" value="40"/>
    <PARAM id="size" value="20"/>
    <PARAM id="density" value="90"/>
    <PARAM id="spray" value="300"/>
    <PARAM id="position" value="150"/>
    <PARAM id="jitter" value="100"/>
